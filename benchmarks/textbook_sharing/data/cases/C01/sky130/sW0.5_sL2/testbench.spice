X1 VSS IB1 IOUT1 C01_sky130_sW0.5_sL2
.include DUT_INCLUDE_PATH
VSS VSS 0 0
VDDB VDDB 0 1.8
IIB1 VDDB IB1 2e-05
.nodeset v(IB1)=0.54

VOUT IOUT1 0 1.8
.control
dc VOUT 1.8 0 -0.0045
let iout = -i(VOUT)
let dev = abs(iout - 2e-05)/2e-05
meas dc iout_t find iout at=1.17
let err = (iout_t - 2e-05)/2e-05
print err
meas dc vmin find v(IOUT1) when dev=0.05 cross=last
meas dc dev_at_vdd find dev at=1.791
let gout = deriv(iout)
meas dc gout_t find gout at=1.17
let rout_v = 1/gout
meas dc rout_t find rout_v at=1.17
echo vout_test = 1.17
quit
.endc
.end

X1 VSS IB1 IOUT1 C01_gf180_sW2_sL1
.include DUT_INCLUDE_PATH
VSS VSS 0 0
VDDB VDDB 0 3.3
IIB1 VDDB IB1 2e-05
.nodeset v(IB1)=0.99

VOUT IOUT1 0 3.3
.control
dc VOUT 3.3 0 -0.00825
let iout = -i(VOUT)
let dev = abs(iout - 2e-05)/2e-05
meas dc iout_t find iout at=1.79
let err = (iout_t - 2e-05)/2e-05
print err
meas dc vmin find v(IOUT1) when dev=0.05 cross=last
meas dc dev_at_vdd find dev at=3.2835
let gout = deriv(iout)
meas dc gout_t find gout at=1.79
let rout_v = 1/gout
meas dc rout_t find rout_v at=1.79
echo vout_test = 1.79
quit
.endc
.end

X1 VSS IIN1 IOUT1 IB1 C13_ihp130_sW1.5_sL1.5
.include DUT_INCLUDE_PATH
VSS VSS 0 0
VDDB VDDB 0 1.2
IIIN1 VDDB IIN1 2e-05
IIB1 VDDB IB1 2e-05
.nodeset v(IIN1)=0.36 v(IB1)=0.36

VOUT IOUT1 0 1.2
.control
dc VOUT 1.2 0 -0.003
let iout = -i(VOUT)
let dev = abs(iout - 2e-05)/2e-05
meas dc iout_t find iout at=0.73
let err = (iout_t - 2e-05)/2e-05
print err
meas dc vmin find v(IOUT1) when dev=0.03 cross=last
meas dc dev_at_vdd find dev at=1.194
let gout = deriv(iout)
meas dc gout_t find gout at=0.73
let rout_v = 1/gout
meas dc rout_t find rout_v at=0.73
echo vout_test = 0.73
quit
.endc
.end

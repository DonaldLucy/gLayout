X1 VSS IIN1 IOUT1 C03_ihp130_sW0.5_sL2
.include DUT_INCLUDE_PATH
VSS VSS 0 0
VDDB VDDB 0 1.2
IIIN1 VDDB IIN1 2e-05
.nodeset v(IIN1)=0.36

VOUT IOUT1 0 1.2
.control
dc VOUT 1.2 0 -0.003
let iout = -i(VOUT)
let dev = abs(iout - 2e-05)/2e-05
meas dc iout_t find iout at=0.99
let err = (iout_t - 2e-05)/2e-05
print err
meas dc vmin find v(IOUT1) when dev=0.1 cross=last
meas dc dev_at_vdd find dev at=1.194
let gout = deriv(iout)
meas dc gout_t find gout at=0.99
let rout_v = 1/gout
meas dc rout_t find rout_v at=0.99
echo vout_test = 0.99
quit
.endc
.end

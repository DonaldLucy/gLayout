X1 VDD VSS VIN1 VOUT1 C15_sky130_sW1.5_sL1
.include DUT_INCLUDE_PATH
VDD VDD 0 1.8
VSS VSS 0 0
VDDB VDDB 0 1.8

* DC servo (disclosed): V_in,dc follows V_out,dc through LFB (open at AC); AC drive through CIN
LFB VOUT1 VIN1 1e6
CIN VAC VIN1 1e6
VAC VAC 0 dc 0 ac 1
CL VOUT1 0 1e-13
.control
op
let vout0 = v(VOUT1)
let vin0 = v(VIN1)
let idd = -i(VDD)
print vout0 vin0 idd
ac dec 20 10 100G
let gdb = db(v(VOUT1))
meas ac gain_lf find gdb at=100
let g3 = gdb - gain_lf + 3
meas ac f3db when g3=0 cross=1
meas ac ugf when gdb=0 cross=1
quit
.endc
.end
